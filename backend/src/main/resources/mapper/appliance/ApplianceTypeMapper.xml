<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.appliance.ApplianceTypeMapper">
    <resultMap id="applianceType" type="com.platform.appliance.ApplianceType">
        <constructor>
            <idArg name="id" column="id" javaType="java.util.UUID"
                   typeHandler="org.apache.ibatis.type.ObjectTypeHandler"/>
            <arg name="code" column="code" javaType="java.lang.String"/>
            <arg name="name" column="name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="applianceTypeResponse" type="com.platform.appliance.ApplianceTypeResponse">
        <constructor>
            <arg name="code" column="code" javaType="java.lang.String"/>
            <arg name="name" column="name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="findActiveByCode" resultMap="applianceType">
        SELECT id, code, name
        FROM appliance_type
        WHERE code = #{code} AND active = true
    </select>

    <select id="findAllActive" resultMap="applianceTypeResponse">
        SELECT code, name
        FROM appliance_type
        WHERE active = true
        ORDER BY display_order, name
    </select>
</mapper>
